DATABASE_URL=postgresql://yourcareer:yourcareer@localhost:5432/yourcareerbuddy
SECRET_KEY=change-me
OPENAI_API_KEY=sk-

# NVIDIA NIM model selection (see backend/services/nvidia_llm.py and
# backend/scripts/bench_nvidia_extraction.py for how these were chosen)
NVIDIA_MODEL=vendor/model-id
NVIDIA_FALLBACK_MODEL=
NVIDIA_TIMEOUT=60
# CV extraction (whole CV, often text read from page images) gets its own longer limit
NVIDIA_EXTRACTION_TIMEOUT=120
# Model used to read text from image-only PDF pages
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Optional JSON merged into every request, or keyed by model id, e.g.
# NVIDIA_EXTRA_BODY={"openai/gpt-oss-20b": {"reasoning_effort": "low"}}
NVIDIA_EXTRA_BODY=

# Google Gemini (optional, recommended for speed). When set, Gemini is used first and NVIDIA is the fallback.
# Get a key at https://aistudio.google.com/apikey ; check it with backend/scripts/check_gemini.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=40
# LLM_PROVIDER=nvidia   # uncomment to try NVIDIA first instead

# Optional: Hunter.io lists emails a company has published online (free plan at hunter.io). Improves recipient finding.
HUNTER_API_KEY=
