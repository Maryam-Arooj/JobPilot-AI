# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yourcareerbuddy

# JWT & Security Credentials
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
NEXTAUTH_SECRET=change-me-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# NVIDIA NIM LLM API (Nemotron 120B, Llama 3.2, etc.)
OPENAI_API_KEY=your_nvidia_api_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Real-Time Job Discovery API (SerpAPI Google Jobs Engine)
SERPAPI_KEY=your_serpapi_key_here
# Alternative alias:
# SERP_API_KEY=your_serpapi_key_here

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
